{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate-and-seed": "node dist/core/db/migrate-and-seed.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typeorm": "node --require tsx/cjs --import tsx ../../node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/core/db/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/core/db/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/core/db/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/core/db/data-source.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-redis": "^8.1.0",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "reflect-metadata": "^0.2.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "redis": "^4.7.1",
    "amqplib": "^0.10.8",
    "socket.io": "^4.8.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.3.0",
    "@types/amqplib": "^0.10.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
