# Скопируйте в файл с любым именем и заполните.
# docker compose -f docker-compose.production.yml --env-file ./<этот-файл> up -d --build
# ENV_FILE — тот же путь, что в --env-file (Compose отдаёт файл контейнерам).
# Для production compose хосты - имена сервисов (postgres, redis, rabbitmq), а не localhost.

ENV_FILE=./production.env

# --- API / UI ---
API_PORT=4000
API_ORIGIN=http://localhost:4000
NGINX_PORT=80
SESSION_SECRET=dev-session-secret
COOKIE_SECURE=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic_plus

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=clinic
RABBITMQ_PASSWORD=clinic
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://clinic:clinic@localhost:5672

# --- docker-compose.production.yml (подставить вместо localhost) ---
# POSTGRES_HOST=postgres
# REDIS_URL=redis://redis:6379
# RABBITMQ_URL=amqp://clinic:clinic@rabbitmq:5672
# COOKIE_SECURE=true только за HTTPS; для HTTP nginx оставьте false
